        # Controle de estado do Quiz
        self.indice_pergunta = 0
        self.pontuacao = 0

        # Inicia o aplicativo na tela de Boas-Vindas
        self.criar_tela_inicial()

    def limpar_tela(self):
        """Remove todos os componentes visuais da tela atual."""
        for widget in self.root.winfo_children():
            widget.destroy()

    def criar_tela_inicial(self):
        """Monta a tela de abertura do sistema."""
        self.limpar_tela()

        container = tk.Frame(self.root, bg=self.COR_FUNDO, padx=30, pady=40)
        container.pack(expand=True, fill="both")

        lbl_boas_vindas = tk.Label(
            container,
            text="🎓 Bem-vindo ao Aprendiz Digital!",
            font=self.FONTE_TITULO,
            fg=self.COR_AZUL_ESCURO,
            bg=self.COR_FUNDO
        )
        lbl_boas_vindas.pack(pady=20)

        lbl_instrucoes = tk.Label(
            container,
            text="Este jogo vai ajudar você a navegar na internet e usar o computador com segurança!\n\n"
                 "• Responda às perguntas no seu ritmo.\n"
                 "• Leia com atenção cada explicação.\n"
                 "• Não tenha medo de errar: errando também se aprende!",
            font=self.FONTE_SUBTITULO,
            fg=self.COR_TEXTO,
            bg=self.COR_FUNDO,
            justify="left",
            wraplength=700
        )
        lbl_instrucoes.pack(pady=30)

        btn_iniciar = tk.Button(
            container,
            text="🚀 Iniciar o Quiz",
            font=("Arial", 16, "bold"),
            bg=self.COR_AZUL_BOTAO,
            fg="white",
            activebackground=self.COR_AZUL_ESCURO,
            activeforeground="white",
            padx=20,
            pady=10,
            cursor="hand2",
            command=self.iniciar_quiz
        )
        btn_iniciar.pack(pady=20)

    def iniciar_quiz(self):
        """Reinicia variáveis e exibe a primeira pergunta."""
        self.indice_pergunta = 0
        self.pontuacao = 0
        self.exibir_pergunta()

    def exibir_pergunta(self):
        """Renderiza a pergunta atual na interface."""
        self.limpar_tela()
        dados_q = self.perguntas[self.indice_pergunta]

        container = tk.Frame(self.root, bg=self.COR_FUNDO, padx=20, pady=20)
        container.pack(expand=True, fill="both")

        # Categoria e Progresso
        lbl_progresso = tk.Label(
            container,
            text=f"Pergunta {self.indice_pergunta + 1} de {len(self.perguntas)}",
            font=("Arial", 12, "bold"),
            fg="#6B7280",
            bg=self.COR_FUNDO
        )
        lbl_progresso.pack(anchor="w")

        lbl_categoria = tk.Label(
            container,
            text=dados_q["categoria"],
            font=self.FONTE_SUBTITULO,
            fg=self.COR_AZUL_ESCURO,
            bg=self.COR_FUNDO
        )
        lbl_categoria.pack(anchor="w", pady=(0, 15))

        # Texto da Pergunta
        lbl_pergunta = tk.Label(
            container,
            text=dados_q["pergunta"],
            font=self.FONTE_PERGUNTA,
            fg=self.COR_TEXTO,
            bg=self.COR_FUNDO,
            justify="left",
            wraplength=750
        )
        lbl_pergunta.pack(anchor="w", pady=(0, 20))

        # Botões de Opções de Resposta
        self.botoes_opcoes = []
        for i, opcao_texto in enumerate(dados_q["opcoes"]):
            btn = tk.Button(
                container,
                text=opcao_texto,
                font=self.FONTE_OPCAO,
                bg="white",
                fg=self.COR_TEXTO,
                activebackground="#E5E7EB",
                anchor="w",
                justify="left",
                padx=15,
                pady=12,
                wraplength=700,
                cursor="hand2",
                command=lambda idx=i: self.verificar_resposta(idx)
            )
            btn.pack(fill="x", pady=6)
            self.botoes_opcoes.append(btn)

        # Área de Feedback (Explicação de Certo/Errado)
        self.lbl_feedback = tk.Label(
            container,
            text="",
            font=self.FONTE_FEEDBACK,
            bg=self.COR_FUNDO,
            justify="left",
            wraplength=750
        )
        self.lbl_feedback.pack(pady=15, anchor="w")

        # Botão Próxima Pergunta (inicialmente oculto/desativado)
        self.btn_proxima = tk.Button(
            container,
            text="Próxima Pergunta ➔",
            font=("Arial", 14, "bold"),
            bg=self.COR_AZUL_BOTAO,
            fg="white",
            padx=15,
            pady=8,
            cursor="hand2",
            state="disabled",
            command=self.avancar_pergunta
        )
        self.btn_proxima.pack(anchor="e", pady=10)

    def verificar_resposta(self, opcao_selecionada):
        """Valida a resposta do usuário, exibe o feedback e atualiza pontuação."""
        dados_q = self.perguntas[self.indice_pergunta]
        resposta_correta = dados_q["correta"]

        # Desativa todos os botões de opção para evitar múltiplos cliques
        for btn in self.botoes_opcoes:
            btn.config(state="disabled")

        if opcao_selecionada == resposta_correta:
            self.pontuacao += 1
            self.botoes_opcoes[opcao_selecionada].config(bg="#DCFCE7", fg=self.COR_VERDE_ACERTO)
            self.lbl_feedback.config(
                text=f"✅ {dados_q['explicacao']}",
                fg=self.COR_VERDE_ACERTO
            )
        else:
            self.botoes_opcoes[opcao_selecionada].config(bg="#FEE2E2", fg=self.COR_VERMELHO_ERRO)
            self.botoes_opcoes[resposta_correta].config(bg="#DCFCE7", fg=self.COR_VERDE_ACERTO)
            self.lbl_feedback.config(
                text=f"❌ Ops! A resposta certa era a número {resposta_correta + 1}.\n💡 Dica: {dados_q['explicacao']}",
                fg=self.COR_VERMELHO_ERRO
            )

        # Habilita o botão para avançar
        self.btn_proxima.config(state="normal")

    def avancar_pergunta(self):
        """Avança para a próxima pergunta ou exibe o resultado final."""
        self.indice_pergunta += 1
        if self.indice_pergunta < len(self.perguntas):
            self.exibir_pergunta()
        else:
            self.exibir_resultado_final()

    def exibir_resultado_final(self):
        """Exibe a tela final com a pontuação e mensagem motivacional."""
        self.limpar_tela()

        container = tk.Frame(self.root, bg=self.COR_FUNDO, padx=30, pady=40)
        container.pack(expand=True, fill="both")

        lbl_fim = tk.Label(
            container,
            text="🎉 Parabéns! Você concluiu o Quiz!",
            font=self.FONTE_TITULO,
            fg=self.COR_AZUL_ESCURO,
            bg=self.COR_FUNDO
        )
        lbl_fim.pack(pady=15)

        total = len(self.perguntas)
        lbl_resultado = tk.Label(
            container,
            text=f"Você acertou {self.pontuacao} de {total} perguntas.",
            font=("Arial", 18, "bold"),
            fg=self.COR_TEXTO,
            bg=self.COR_FUNDO
        )
        lbl_resultado.pack(pady=10)

        # Mensagem motivacional baseada no desempenho
        if self.pontuacao == total:
            mensagem = "Sensacional! Você demonstrou excelente conhecimento e já está pronto para navegar na internet com muita segurança!"
        elif self.pontuacao >= total // 2:
            mensagem = "Muito bem! Você já aprendeu bastante sobre o mundo digital. Continue praticando para ficar cada vez mais seguro!"
        else:
            mensagem = "Foi um ótimo começo! A prática leva à perfeição. Que tal jogar novamente para fixar o aprendizado?"

        lbl_mensagem = tk.Label(
            container,
            text=mensagem,
            font=self.FONTE_SUBTITULO,
            fg=self.COR_TEXTO,
            bg=self.COR_FUNDO,
            justify="center",
            wraplength=650
        )
        lbl_mensagem.pack(pady=20)

        # Botões da tela final
        frame_botoes = tk.Frame(container, bg=self.COR_FUNDO)
        frame_botoes.pack(pady=20)

        btn_reiniciar = tk.Button(
            frame_botoes,
            text="🔄 Jogar Novamente",
            font=("Arial", 14, "bold"),
            bg=self.COR_AZUL_BOTAO,
            fg="white",
            padx=15,
            pady=10,
            cursor="hand2",
            command=self.iniciar_quiz
        )
        btn_reiniciar.pack(side="left", padx=10)

        btn_sair = tk.Button(
            frame_botoes,
            text="❌ Sair do Programa",
            font=("Arial", 14, "bold"),
            bg="#9CA3AF",
            fg="white",
            padx=15,
            pady=10,
            cursor="hand2",
            command=self.root.destroy
        )
        btn_sair.pack(side="left", padx=10)


if __name__ == "__main__":
    root = tk.Tk()
    app = QuizAlfabetizacaoDigital(root)
    root.mainloop()
